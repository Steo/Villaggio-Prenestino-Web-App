# Configurazione Apache per Web App in sottocartella /app/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /app/

  # Risoluzione automatica risorse: se richieste in /assets/ ma presenti direttamente in /app/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/(.*)$ /app/$1 [L]

  # Risoluzione automatica risorse: se richieste in /app/ ma presenti in /app/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^([^/]+\.(js|css|map|png|svg|jpg|webp))$ /app/assets/$1 [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /app/index.html [L]
</IfModule>

# Caching risorse statiche e tipi MIME per PWA
AddType application/manifest+json .webmanifest .json
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"
</IfModule>
